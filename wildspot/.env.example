# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Mapbox — Account → Tokens. Public token (pk.*). Restrict to your Vercel domain.
VITE_MAPBOX_TOKEN=pk.eyJ1...

# Mapbox Studio style URL. Either use mapbox://styles/mapbox/outdoors-v12 to start,
# or duplicate Outdoors in Studio, restyle, publish, and paste your custom URL here.
VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/outdoors-v12
